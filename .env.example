# AcademiQ runs in local in-memory demo mode when these values are blank.
NODE_ENV=development
PORT=3000

# Optional MySQL persistence
DATABASE_URL=

# Optional managed OAuth/session integration
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
JWT_SECRET=replace_with_a_long_random_value_for_non_demo_use

# Optional managed storage/media/map/notification adapters
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional live AI advising
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
